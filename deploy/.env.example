# EJEMPLO DE ARCHIVO .env PARA PRODUCCIÓN

# ============================================
# BASE DE DATOS
# ============================================
# Formato: postgresql://USUARIO:PASSWORD@HOST:PUERTO/NOMBRE_BD
# Ejemplo: postgresql://clinica_user:MiPass123@localhost:5432/clinica_facturas
DATABASE_URL=postgresql://TU_USUARIO_BD:TU_PASSWORD_BD@localhost:5432/TU_NOMBRE_BD

# ============================================
# SEGURIDAD
# ============================================
# Genera una clave secreta larga y aleatoria
# Puedes usar: https://randomkeygen.com/
JWT_SECRET=CAMBIA_ESTA_CLAVE_POR_UNA_MUY_SEGURA_Y_LARGA_2024

# ============================================
# SERVIDOR
# ============================================
PORT=3500
NODE_ENV=production

# ============================================
# ARCHIVOS Y UPLOADS
# ============================================
# Ruta absoluta en el servidor donde se guardarán los archivos subidos
# Ejemplo: /home/miusuario/facturas_uploads
SOPORTES_PATH=/home/TU_USUARIO_HOSTING/facturas_uploads

# ============================================
# INSTRUCCIONES
# ============================================
# 1. Copia este archivo y renómbralo a ".env" (sin el .example)
# 2. Reemplaza TODOS los valores en MAYÚSCULAS con tus datos reales
# 3. NO compartas este archivo ni lo subas a Git
# 4. Crea este archivo directamente en el servidor en la carpeta de la aplicación
